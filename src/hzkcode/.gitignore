# Dependencies
node_modules

# Build output
dist
src-tauri/target
src-tauri/gen

# Bundled CLI binaries (bundle.resources copies them into the app package);
# 100MB+ each, never committed — the slot README stays tracked.
src-tauri/binaries/*
!src-tauri/binaries/README.md

# Secrets — never commit
.env
.env.*
*.pem
*.key
*.p12

# OS
.DS_Store
Thumbs.db

# Plugin development checkouts — plugins are separate GitHub repos under the
